{
    "$schema": "./signal_simulator.schema.json",
    "signal": {
        "waveform": "sine",
        "frequency_hz": 50.0,
        "nominal_amplitude": 3.3,
        "offset": 0.0,
        "channels": [
            {
                "phase_deg": 0.0
            },
            {
                "phase_deg": 120.0
            },
            {
                "phase_deg": 240.0
            }
        ]
    },
    "sampling": {
        "samples_per_cycle": 128
    },
    "output": {
        "representation": "adc_integer",
        "layout": "interleaved",
        "adc": {
            "reference_amplitude": 5.0,
            "polarity": "bipolar",
            "resolution_bits": 16
        }
    },
    "buffer": {
        "slot_count": 4,
        "block_size_samples_per_channel": 32
    },
    "ipc": {
        "shared_memory_name": "/sigsim_mem",
        "semaphore_name": "/sigsim_data_ready"
    },
    "disturbance_timeline": [
        {
            "type": "surge",
            "start_time_ns": 100000000,
            "duration_ns": 2000000,
            "target_channels": [0],
            "shape": "half_sine",
            "peak_amplitude": 1.5
        },
        {
            "type": "sag",
            "start_time_ns": 200000000,
            "duration_ns": 100000000,
            "target_channels": [1],
            "scaling_factor": 0.65
        },
        {
            "type": "swell",
            "start_time_ns": 400000000,
            "duration_ns": 100000000,
            "target_channels": [0, 1, 2],
            "scaling_factor": 1.25
        },
        {
            "type": "frequency_distortion",
            "mode": "step",
            "start_time_ns": 600000000,
            "duration_ns": 200000000,
            "delta_frequency_hz": 5.0
        }
    ]
}
